        <name>Check Schedule Conflict</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    var learningModule = g_form.getValue('learning_module');
    var date = g_form.getValue('date');

    if (!learningModule || !date) {
        return;
    }

    var ga = new GlideAjax('CheckTrainingSchedule');  
    ga.addParam('learning_module', learningModule);
    ga.addParam('date', date);

    ga.getXMLAnswer(function(response) {
        var answer = response.responseXML.documentElement.getAttribute("answer");

        if (answer === 'true') {
            g_form.addErrorMessage('There is already a training scheduled for this course on the same date.');
            g_form.setValue('learning_module', '');
            g_form.setValue('date', '');
        }
    });
}]]></script>
