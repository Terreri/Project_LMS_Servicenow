        <script><![CDATA[var CheckTrainingSchedule = Class.create();
CheckTrainingSchedule.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
 
    checkSchedule: function() {
        var learning_module = this.getParameter("sysparm_learning_module");
        var date = this.getParameter("sysparm_date");
 
        var grSchedule = new GlideRecord('x_1584312_lms_training_schedule');
        grSchedule.addQuery('learning_module', learning_module);
        grSchedule.addQuery('date', date);
        grSchedule.query();
 
        if (grSchedule.next()) {
            return 'true';
        }
        return 'false';
    },
 
    type: 'CheckTrainingSchedule'
});]]></script>
