        <script><![CDATA[var SendEmailinScheduleDay = Class.create();
SendEmailinScheduleDay.prototype = {
    initialize: function() {
    },
    getEnrolledUsers: function(trainingScheduleId) {
        var enrolledUsers = [];
        var grEnroll = new GlideRecord('x_1584312_lms_enrollment');
        grEnroll.addQuery('training_schedule', trainingScheduleId);
        grEnroll.addQuery('state', 'IN', '3'); 
        grEnroll.query();
        while (grEnroll.next()) {
            enrolledUsers.push('<li>' + grEnroll.opened_by.name() + '</li>');
        }
        return enrolledUsers.join('');
    },
    type: 'SendEmailinScheduleDay'
};]]></script>
