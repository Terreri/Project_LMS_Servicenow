        <script><![CDATA[var LMSUtils = Class.create();
LMSUtils.prototype = {
    initialize: function() {
    },
	refQualSchedule: function(){
		var userID = gs.getUserID(); //ID do usuário logado
		gs.info("Esse é o User ID:" + userID);
		var grEnroll = new GlideRecord("x_1584312_lms_enrollment");

		grEnroll.addQuery("user", userID);
		grEnroll.query();

		var enrolledSchedules = [];
		while(grEnroll.next()){
			enrolledSchedules.push(grEnroll.training_schedule); //duvida aqui
		}

		return 'sys_idNOT IN [' + enrolledSchedules.join(",") + "]";

		
	},

    type: 'LMSUtils'
};]]></script>
